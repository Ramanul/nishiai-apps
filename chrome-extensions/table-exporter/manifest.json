{
  "manifest_version": 3,
  "name": "Table Exporter \u2014 tables to CSV",
  "version": "1.0.0",
  "description": "Export every table on the current page to CSV in one click. Local only, no tracking.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Export tables to CSV",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "key": ""
}